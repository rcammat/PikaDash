NODE_ENV=production
HOST=0.0.0.0
PORT=5001
PIKADASH_PORT=5001

# URL pública real del panel
PUBLIC_BASE_URL=https://pikadash.rcammat.com
FRONTEND_URL=https://pikadash.rcammat.com
DISCORD_CALLBACK_URL=https://pikadash.rcammat.com/auth/discord/callback

# Credenciales OAuth Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cookies / sesión
SESSION_SECRET=
JWT_SECRET=
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_DOMAIN=

# PikaBot dentro de la red Docker compartida
PIKABOT_API_URL=http://api:5000
PIKABOT_CONTROL_URL=http://bot:3300
BOT_CONTROL_SECRET=pikabot-local-control

# Para construir el enlace de invitación al bot desde PikaDash
BOT_TOKEN=
BOT_PERMISSIONS=8

# Cloudflare Tunnel (opcional si quieres publicar PikaDash sin abrir puertos)
CLOUDFLARED_TUNNEL_TOKEN=
